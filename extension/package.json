{
  "name": "dovetailed-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build": "npm run build:chrome && npm run build:firefox",
    "postinstall": "wxt prepare",
    "test": "vitest run --passWithNoTests",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "flag-icons": "^7.6.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.25.0",
    "pdfjs-dist": "6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  }
}
